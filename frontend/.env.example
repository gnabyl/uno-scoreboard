# Local development (`vercel dev`) only — read by api/model.js to sign the
# private model blob. Server-side only; never prefix with REACT_APP_.
BLOB_READ_WRITE_TOKEN=

# Optional: detection confidence threshold (default 0.25).
REACT_APP_MIN_CONFIDENCE=0.25

# Multiplayer rooms. Create React App only exposes REACT_APP_* variables, so
# copy the Supabase project URL and anon/publishable key into these names
# (the Vercel integration's SUPABASE_URL / NEXT_PUBLIC_* names are not read by
# the browser bundle).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
