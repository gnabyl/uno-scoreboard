# Local development (`vercel dev`) only — read by api/model.ts to sign the
# private model blob. Server-side only; never prefix with VITE_.
BLOB_READ_WRITE_TOKEN=

# Optional: detection confidence threshold (default 0.25).
VITE_MIN_CONFIDENCE=0.25

# Optional: overlap above which two detections are the same card
# (default 0.8). Set to 1 to switch the merge off - a card the model read as
# two different classes is then counted twice.
VITE_DEDUPE_IOU=0.8

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
